# DATABASE_URL=postgresql://...   (leer lassen = lokale SQLite-Datei data/testas.db)
# Admin(s): E-Mail-Adresse(n) des/der Konten, die Gruppen verwalten und Ergebnisse sehen (kommagetrennt)
